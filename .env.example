# Variaveis de ambiente para o PAMDA ERP B2B
# Copie este arquivo para .env no desenvolvimento local:
# cp .env.example .env

# Configuracao do Supabase (Opcional no ambiente local; o sistema possui camada
# de armazenamento reativa e persistente integrada para execucao imediata)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui

# Chave Pix padrao da Pamda Cases
VITE_DEFAULT_PIX_KEY=capaspix@gmail.com
VITE_DEFAULT_PIX_KEY_TYPE=email
VITE_BENEFICIARY_NAME=PAMDA CASES IND E COM
