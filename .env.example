# Variaveis de ambiente para o PAMDA ERP B2B
# Copie este arquivo para .env no desenvolvimento local:
# cp .env.example .env

# Obrigatorio: Project URL real do projeto EXISTENTE erp-pamda (Settings > API).
# O nome do projeto nao e necessariamente seu hostname.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# Preferir publishable; chave publica anon legada tambem e aceita.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_pela_chave_publica
VITE_SUPABASE_ANON_KEY=
# FUTURO: habilitar somente depois de revisar/instalar customer_branches.is_primary.
VITE_CUSTOMER_BRANCHES_PRIMARY_ENABLED=false
# Login por e-mail/senha via Supabase Auth; perfil em erp_user_profiles.
# Somente a chave pública do Supabase pode ser usada neste frontend.

# Chave Pix padrao da Pamda Cases
VITE_DEFAULT_PIX_KEY=capaspix@gmail.com
VITE_DEFAULT_PIX_KEY_TYPE=email
VITE_BENEFICIARY_NAME=PAMDA CASES IND E COM
